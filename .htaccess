Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve application code, config or SQL directly
    RewriteRule ^(app|config|database|lang|storage)(/|$) - [F,L]
    RewriteRule (^|/)\.(git|htaccess|gitignore) - [F,L]

    # Uploaded files are pictures only: never run or serve a script from the uploads folder
    RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|html?|svg)$ - [F,L,NC]

    # Real files (css, js, images, uploads) are served as they are
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Everything else goes to the front controller
    RewriteRule ^ index.php [L]
</IfModule>
